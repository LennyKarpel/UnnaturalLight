{
  "name": "unnaturallight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UnnaturalLight show server: serves the console and stage, owns the show state and drives the DMX USB Pro(s)",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/server.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "test:browser": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/browser/*.test.ts\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "marked": "18.2.0",
    "serialport": "^13.0.0",
    "three": "0.160.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.2",
    "typescript": "5.9"
  },
  "allowScripts": {
    "@serialport/bindings-cpp": false
  }
}
